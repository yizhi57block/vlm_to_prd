OPENROUTER_API_KEY=sk-or-v1-your-key-here

# 可选：按顺序尝试。第一项为性价比首选，后续为备用模型。
# OPENROUTER_MODELS=qwen/qwen3.7-flash,qwen/qwen3.8-flash,qwen/qwen3.8-27b,qwen/qwen3.5-397b-a17b,qwen/qwen3.8-max-0902

# 可选：只允许 Zero Data Retention provider。若模型没有 ZDR provider，请求会失败。
# REQUIRE_ZDR=1

# 可选
# VIDEO_DIR=videos
# OUTPUT_DIR=analysis-results
# MAX_OUTPUT_TOKENS=12000
# REQUEST_TIMEOUT_MS=1800000
